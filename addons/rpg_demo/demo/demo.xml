<odoo>
    <data>

         <!-- FACCIÓ -->
    <record id="faccio_guardians" model="rpg.faccio">
        <field name="name">Guardians de la Llum</field>
    </record>


    <!-- HEROI PRINCIPAL -->
    <record id="heroi_principal" model="rpg.heroi">

        <field name="name">Arthas</field>

        <!-- IMATGE -->
        <field name="imatge"
               type="base64"
               file="rpg_demo/demo/images/heroe.png"/>

        <!-- DATA ACTUAL MENYS 30 DIES -->
        <field name="data_creacio"
               eval="(DateTime.today() - relativedelta(days=30)).strftime('%Y-%m-%d')"/>

        <!-- REFERENCIA MANY2ONE -->
        <field name="faccio_id" ref="faccio_guardians"/>

        <!-- MANY2MANY: CREACIÓ D'HABILITATS -->
        <field name="habilitat_ids" eval="[
            (0, 0, {
                'name': 'Espasa sagrada',
                'descripcio': 'Atac amb espasa màgica',
                'nivell': 10
            }),
            (0, 0, {
                'name': 'Escut protector',
                'descripcio': 'Protecció contra enemics',
                'nivell': 8
            }),
            (0, 0, {
                'name': 'Magia de luz',
                'descripcio': 'Magia luminosa',
                'nivell': 9
            })
        ]"/>

    </record>


    <!-- AVALUADOR: IMATGE -->
    <record id="avaluador_imatge" model="rpg.avaluador">
        <field name="nom_model">rpg.heroi</field>
        <field name="ext_id">rpg_demo.heroi_principal</field>
        <field name="requisit">img</field>
    </record>


    <!-- AVALUADOR: REFERENCIA -->
    <record id="avaluador_referencia" model="rpg.avaluador">
        <field name="nom_model">rpg.heroi</field>
        <field name="ext_id">rpg_demo.heroi_principal</field>
        <field name="requisit">ref</field>
    </record>


    <!-- AVALUADOR: DATA -->
    <record id="avaluador_data" model="rpg.avaluador">
        <field name="nom_model">rpg.heroi</field>
        <field name="ext_id">rpg_demo.heroi_principal</field>
        <field name="requisit">dat</field>
    </record>


    <!-- AVALUADOR: MANY2MANY -->
    <record id="avaluador_many2many" model="rpg.avaluador">
        <field name="nom_model">rpg.heroi</field>
        <field name="ext_id">rpg_demo.heroi_principal</field>
        <field name="requisit">m2m</field>
    </record>


    </data>
</odoo>
